# Kopiera filen till .env.local och fyll i det du vill använda. Allt här är valfritt:
# Presenter fungerar utan någon av inställningarna.

# Publikläget och livefrågorna: publiken ansluter med en kod och svarar från mobilen.
# Skapa ett projekt på supabase.com, kör migreringarna i supabase/migrations (se supabase/README.md)
# och klistra in projektets adress och publika nyckel (anon key).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Bildsök i Pexels i editorn.
PEXELS_API_KEY=

# Mappen där appen sparar inställningar, verktyg och inspelningar. Standard är ~/.presenter.
# PRESENTER_DATA=
